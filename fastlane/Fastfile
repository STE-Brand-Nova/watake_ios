default_platform(:ios)
opt_out_usage

PROJECT = "watake.xcodeproj"
DEV_SCHEME = "Watake-Dev"
PROD_SCHEME = "Watake-Prod"
APP_IDENTIFIER = ENV.fetch("APP_IDENTIFIER", "com.reypryma.watake")

def app_store_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_KEY_CONTENT"),
    is_key_content_base64: true
  )
end

platform :ios do
  desc "Run unit and UI tests on the development scheme"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: DEV_SCHEME,
      devices: [ENV.fetch("SCAN_DEVICE", "iPhone 17")],
      clean: true,
      code_coverage: true,
      output_types: "junit",
      output_directory: "fastlane/test_output"
    )
  end

  private_lane :signed_archive do |options|
    ensure_env_vars(
      env_vars: %w[
        APP_STORE_CONNECT_KEY_ID
        APP_STORE_CONNECT_ISSUER_ID
        APP_STORE_CONNECT_KEY_CONTENT
        MATCH_GIT_URL
        MATCH_PASSWORD
      ]
    )

    setup_ci if ENV["CI"]
    api_key = app_store_api_key

    match(
      type: "appstore",
      readonly: ENV["CI"] == "true",
      api_key: api_key,
      app_identifier: APP_IDENTIFIER
    )

    increment_build_number(
      xcodeproj: PROJECT,
      build_number: latest_testflight_build_number(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER,
        initial_build_number: 0
      ) + 1
    )

    build_app(
      project: PROJECT,
      scheme: PROD_SCHEME,
      clean: true,
      export_method: "app-store",
      output_directory: "build",
      output_name: "Watake-#{options[:version] || 'build'}.ipa"
    )

    api_key
  end

  desc "Build and upload the current production version to TestFlight"
  lane :beta do
    api_key = signed_archive
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and upload production; review submission is explicitly opt-in"
  lane :release do |options|
    api_key = signed_archive(version: options[:version])
    should_submit = ENV.fetch("SUBMIT_FOR_REVIEW", "false") == "true"

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      submit_for_review: should_submit,
      automatic_release: false,
      phased_release: true,
      skip_metadata: true,
      skip_screenshots: true,
      force: true
    )
  end
end
